# Salin file ini menjadi `.env` dan isi nilainya:
#   cp .env.example .env
# File `.env` TIDAK BOLEH di-commit (sudah ada di .gitignore).

# Secret key Django — WAJIB diisi. Buat yang baru dengan:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# JANGAN pakai secret key lama yang pernah ter-commit ke git.
SECRET_KEY=isi-dengan-secret-key-baru-di-sini

# Jalankan dengan debug aktif (hanya untuk development lokal).
# Nilai yang diterima: True / False (default: False).
DEBUG=True

# Host yang diizinkan, dipisah koma tanpa spasi.
# Contoh untuk deploy: ALLOWED_HOSTS=laundryasaka.example.com,www.laundryasaka.example.com
ALLOWED_HOSTS=localhost,127.0.0.1
